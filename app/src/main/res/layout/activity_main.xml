<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LocalCash - Panel Principal"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnNuevoMovimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Movimiento"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnVerMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Mapa de Transacciones"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnContactos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agenda de Contactos"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnGastosCompartidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dividir Gastos / Deudas" />

</LinearLayout>